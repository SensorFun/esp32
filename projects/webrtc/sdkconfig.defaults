CONFIG_PROVISIONING_SECURE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep SCTP packets and settings payloads in PSRAM; reserve internal RAM for Wi-Fi and DMA.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# Motion and recorder task stacks live in PSRAM; neither task writes flash.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Lets EXT_RAM_BSS_ATTR place motion decoder scratch in PSRAM on the ESP32.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The main task also runs the peer worker (peak use about 10 KB). It and the
# camera task run on CPU1, so camera DMA copies and the camera interrupt never
# compete with Wi-Fi on CPU0; sharing CPU0 stalled Wi-Fi TX at large frame sizes.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_CAMERA_CORE1=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_CJSON_NESTING_LIMIT=16
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_CAMERA_REMOTE_ACCESS=y
