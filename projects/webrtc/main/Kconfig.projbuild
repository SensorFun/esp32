menu "Camera remote signaling"

config CAMERA_SIGNALING_API_SECRET
    string "Signaling server API secret"
    default ""
    help
        Match the local signaling server's SIGNALING_API_SECRET. Keep sdkconfig and
        build outputs private; the secret is embedded in the flashed firmware.

config CAMERA_SIGNALING_STUN_URL
    string "STUN URL for direct signaled camera connections"
    default "stun:stun.l.google.com:19302"
    help
        Only stun: or stuns: URLs are supported. The signaling server routes
        signaling messages only; the browser and camera establish a direct
        WebRTC connection.

config CAMERA_SNTP_SERVER
    string "SNTP server for recording timestamps"
    default "pool.ntp.org"
    help
        Motion recordings are named by UTC time. Until this server answers,
        the camera uses the clock of the first connected viewer.

endmenu
