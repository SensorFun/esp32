{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "device",
      "type": "pickString",
      "description": "Device profile to flash (config/device/*.yaml)",
      "options": [
        "esp32_cam",
        "esp32s3_wroom",
        "esp32s3_goouuu"
      ]
    }
  ],
  "tasks": [
    {
      "label": "Build Firmware (All Boards)",
      "detail": "Build WebRTC firmware for every device, one after another; flash from Run Website Locally",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 tools/build.py --multirun project=webrtc device=esp32_cam,esp32s3_wroom,esp32s3_goouuu",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Website Locally",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--firmware-dir", "${workspaceFolder}/build"],
      "options": {
        "cwd": "${workspaceFolder}/site"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flash Board",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 tools/flash.py project=webrtc device=${input:device} clear_nvs=false",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flash Board (Clear NVS)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python3 tools/flash.py project=webrtc device=${input:device} clear_nvs=true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
